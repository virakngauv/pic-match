[Unit]
Description=Pic Match single-process game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=picmatch
Group=picmatch
WorkingDirectory=/srv/pic-match
EnvironmentFile=/etc/pic-match-game.env
ExecStart=/usr/bin/node --import tsx /srv/pic-match/server/index.ts
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
